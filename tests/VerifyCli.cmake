file(MAKE_DIRECTORY "${WORK}")
function(run output)
  execute_process(COMMAND "${SEARCH}" ${ARGN} --quiet
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE error TIMEOUT 30)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "CLI failed (${status}): ${error}")
  endif()
  set(${output} "${text}" PARENT_SCOPE)
endfunction()
run(single --upper 35 --threads 1)
run(parallel --upper 35 --threads 4)
run(reference --upper 35 --mode brute-force)
foreach(name single parallel reference)
  string(REGEX REPLACE "#[^\n]*\n" "" ${name} "${${name}}")
endforeach()
if(NOT single STREQUAL parallel OR NOT single STREQUAL reference)
  message(FATAL_ERROR "CLI search rows differ by mode or thread count")
endif()
file(WRITE "${WORK}/input.log" "1/2,12/1\n1/3,75/1\n1/2,12/1\n1/4,0/1\n")
run(imported --input "${WORK}/input.log")
if(NOT imported MATCHES "1/2,1/3,12/1,75/1,900/1")
  message(FATAL_ERROR "Missing imported square-product pair")
endif()
execute_process(COMMAND "${RUNNER}" --input "${WORK}/input.log" --quiet
  RESULT_VARIABLE runner_status OUTPUT_VARIABLE runner_output ERROR_VARIABLE runner_error TIMEOUT 30)
if(NOT runner_status EQUAL 0 OR NOT runner_output STREQUAL imported)
  message(FATAL_ERROR "Log runner differs from checker: ${runner_error}")
endif()
run(signatures --upper 35 --mode generator --output "${WORK}/signatures.txt")
run(filtered --upper 35 --mode filter --signatures "${WORK}/signatures.txt")
if(NOT filtered MATCHES "signature,count")
  message(FATAL_ERROR "Missing filter header")
endif()
run(histogram --upper 35 --mode analysis)
if(NOT histogram MATCHES "bucket_size,bucket_count")
  message(FATAL_ERROR "Missing histogram header")
endif()
# Protect both direct and alias paths from input truncation.
execute_process(COMMAND "${SEARCH}" --input "${WORK}/input.log" --output "${WORK}/./input.log" --quiet
  RESULT_VARIABLE alias_status OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
file(READ "${WORK}/input.log" retained)
if(alias_status EQUAL 0 OR NOT retained MATCHES "1/2,12/1")
  message(FATAL_ERROR "Input alias was not protected")
endif()
file(WRITE "${WORK}/bad.log" "1/2,12/1\n1/2,75/1\n")
execute_process(COMMAND "${SEARCH}" --input "${WORK}/bad.log" --quiet
  RESULT_VARIABLE invalid_status OUTPUT_QUIET ERROR_VARIABLE invalid_error TIMEOUT 10)
if(invalid_status EQUAL 0 OR NOT invalid_error MATCHES "Conflicting duplicate")
  message(FATAL_ERROR "Conflicting duplicate input was accepted")
endif()
